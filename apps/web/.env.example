# Публичный адрес API для запросов браузера; задаётся при сборке web.
NEXT_PUBLIC_API_URL=http://localhost:3000

# Необязательный адрес API для серверных запросов web.
# В Docker используется http://api:3000; без настройки берётся публичный адрес.
API_INTERNAL_URL=http://localhost:3000

# Необязательный режим разработки интерфейса при ошибке загрузки флагов из API.
# true разрешает отображение всех зарегистрированных разделов только в next dev.
# Записи и состояния в БД не меняет, права управления и доступ к API не даёт.
# В stage и production не работает; для обычной разработки оставьте false.
NEXT_PUBLIC_FEATURE_FLAGS_DEV_FALLBACK=false
