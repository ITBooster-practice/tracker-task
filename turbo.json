{
	"$schema": "https://turborepo.dev/schema.json",
	"globalDependencies": ["**/.env.*local"],
	"globalEnv": [
		"NODE_ENV",
		"NEXT_PUBLIC_FEATURE_FLAGS_DEV_FALLBACK",
		"DATABASE_URL",
		"NEXT_PUBLIC_API_URL",
		"API_INTERNAL_URL"
	],
	"tasks": {
		"dev": {
			"cache": false,
			"persistent": true,
			"env": ["DATABASE_URL", "PORT", "SYSTEM_DEVELOPER_USER_ID"]
		},
		"build": {
			"dependsOn": ["^build"],
			"outputs": [".next/**", "!.next/cache/**", "dist/**"],
			"env": ["DATABASE_URL"]
		},
		"prisma:generate": {
			"cache": false,
			"env": ["DATABASE_URL"]
		},
		"lint": {},
		"test": {
			"dependsOn": ["^build"]
		},
		"type-check": {},
		"test:e2e": {
			"dependsOn": ["^build"]
		}
	}
}
